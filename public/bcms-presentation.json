{
  "$description": "Marketing Starter (\"Coral\") presentation manifest — the THEME's constants, re-declared wholesale on every deploy so the BetterCMS draft renderer previews in this starter's own geometry and chrome instead of the platform's generic white theme. Values mirror the shared design system in globals.css / src/styles/global.css; keep them in lockstep. OKLCH converts to hex here, at declaration time (the renderer only interpolates typed hex).",
  "page.maxWidth": { "$type": "dimension", "$value": 1120 },
  "page.paddingX": { "$type": "dimension", "$value": 36 },
  "type.baseSize": { "$type": "dimension", "$value": 17.6 },
  "type.h1Size": { "$type": "dimension", "$value": 76 },
  "type.headingTracking": { "$type": "dimension", "$value": -0.03 },
  "type.headingLeading": { "$type": "number", "$value": 1.05 },
  "nav.position": { "$type": "custom-ident", "$value": "sticky" },
  "nav.background": { "$type": "color", "$value": "#FBF8F6D9" },
  "nav.borderColor": { "$type": "color", "$value": "#E3DFDC" },
  "nav.fullBleed": { "$type": "boolean", "$value": true },
  "wordmark.suffix": { "$type": "string", "$value": "." },
  "footer.background": { "$type": "color", "$value": "#F4F0ED" },
  "footer.borderColor": { "$type": "color", "$value": "#E3DFDC" },
  "footer.fullBleed": { "$type": "boolean", "$value": true },
  "flow.blockGap": { "$type": "dimension", "$value": 24 },
  "flow.mediaMargin": { "$type": "dimension", "$value": 72 },
  "type.headingMeasure": { "$type": "dimension", "$value": 580 },
  "type.textMeasure": { "$type": "dimension", "$value": 670 },
  "button.secondaryStyle": { "$type": "custom-ident", "$value": "outline" },
  "hairline.color": { "$type": "color", "$value": "#CCC6C2" }
}
